rules_version = '2';

// Johnny Taxi – Cloud Firestore security rules.
// The public website may only CREATE a well-formed ride request. Nobody but an account
// listed in /admins (added by hand in the Firebase console) can read or change requests.
// Everything not allowed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function optStr(d, k, hi) { return !(k in d) || (d[k] is string && d[k].size() >= 1 && d[k].size() <= hi); }

    // Fields every request has, whoever creates it (customer on the site, or Johnny).
    function validRequestBody(id, d) {
      return d.keys().hasAll(['v', 'id', 'code', 'name', 'phone', 'phoneKey', 'from', 'to', 'date', 'time',
                              'passengers', 'wheelchair', 'wheelchairCount', 'lang', 'status', 'history', 'createdAt'])
        && d.v == 1
        && d.id == id && id.matches('^[A-Za-z0-9-]{8,64}$')
        && d.code is string && d.code.matches('^JT-[A-Z2-9]{5}$')
        && str(d.name, 1, 80)
        && d.phone is string && d.phone.matches('^[0-9 +()-]{7,20}$')
        && d.phoneKey == d.phone.replace('[^0-9]', '')
        && d.phoneKey.matches('^[0-9]{7,15}$')
        && str(d.from, 2, 200) && str(d.to, 2, 200)
        && d.date is string && d.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.passengers is int && d.passengers >= 1 && d.passengers <= 8
        && d.wheelchair is bool
        && d.wheelchairCount is int
        && (d.wheelchair ? (d.wheelchairCount >= 1 && d.wheelchairCount <= 3) : d.wheelchairCount == 0)
        && optStr(d, 'email', 120)
        && optStr(d, 'notes', 1000)
        && d.lang in ['he', 'en', 'ar']
        && d.createdAt == request.time
        // trackToken is optional so that forms built before tracking keep working
        && (!('trackToken' in d) || validTrackingPair(id, d));
    }

    // From the public website: always status "new", source "website" (or absent).
    function validNewRequest(id, d) {
      return validRequestBody(id, d)
        && d.keys().hasOnly(['v', 'id', 'code', 'name', 'phone', 'phoneKey', 'from', 'to', 'date', 'time',
                             'passengers', 'wheelchair', 'wheelchairCount', 'lang', 'status', 'history', 'createdAt',
                             'email', 'notes', 'trackToken', 'source'])
        && (!('source' in d) || d.source == 'website')
        && d.status == 'new'
        && d.history == [];
    }

    // Entered by Johnny from the admin screen (a phone call or a WhatsApp message).
    // Same structure; marked with its source and author; may start as new / in progress /
    // confirmed (then with one matching history entry); always gets a tracking link.
    function validManualRequest(id, d) {
      return isAdmin()
        && validRequestBody(id, d)
        && d.keys().hasOnly(['v', 'id', 'code', 'name', 'phone', 'phoneKey', 'from', 'to', 'date', 'time',
                             'passengers', 'wheelchair', 'wheelchairCount', 'lang', 'status', 'history', 'createdAt',
                             'email', 'notes', 'trackToken', 'source', 'createdBy'])
        && d.source in ['phone', 'whatsapp']
        && d.createdBy == request.auth.token.email
        && 'trackToken' in d
        && d.status in ['new', 'in_progress', 'confirmed']
        && (d.status == 'new'
            ? d.history == []
            : (d.history is list && d.history.size() == 1 && validHistoryEntry(d.history[0], d.status)));
    }

    // The request's public tracking document must be created in the same batch.
    function validTrackingPair(id, d) {
      return d.trackToken is string && d.trackToken.matches('^[A-Za-z0-9_-]{43}$')
        && getAfter(/databases/$(database)/documents/tracking/$(d.trackToken)).data.rid == id;
    }

    // UTC day number; the client sends the same key (see firestoreStore.ts).
    function todayKey() { return string(int(math.floor(request.time.toMillis() / 86400000))); }

    // Business-scale caps (per UTC day). They bound how many requests – and therefore
    // writes – the public can create; they do NOT make it impossible to exhaust the
    // free quota (denied attempts still cost reads, see FIREBASE_SETUP.md).
    function siteDailyCap() { return 150; }
    function phoneDailyCap() { return 4; }

    // ---------- ride requests ----------
    match /requests/{id} {
      // Public: create only, together with the two daily counters below in the same
      // atomic batch. A second write with the same id is an update, which the public
      // may never do – so a retry can't create a duplicate.
      allow create: if (validNewRequest(id, request.resource.data)
          && getAfter(/databases/$(database)/documents/dailyCount/$(todayKey())).data.lastId == id
          && getAfter(/databases/$(database)/documents/phoneDaily/$(todayKey() + '_' + request.resource.data.phoneKey)).data.lastId == id)
        // Johnny's manual entries don't use the public daily counters
        || validManualRequest(id, request.resource.data);

      allow get, list: if isAdmin();

      // Admin: only the status and its history may change; customer details stay as sent.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'in_progress', 'confirmed', 'cancelled', 'completed']
        && request.resource.data.history is list
        && request.resource.data.history.size() == resource.data.history.size() + 1
        && (resource.data.history.size() == 0
            || request.resource.data.history[0:resource.data.history.size()] == resource.data.history)
        && validHistoryEntry(request.resource.data.history[resource.data.history.size()], request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email
        // the customer-visible status must change in the same batch, to the same value
        && (!('trackToken' in resource.data)
            || getAfter(/databases/$(database)/documents/tracking/$(resource.data.trackToken)).data.status == request.resource.data.status);

      allow delete: if false;
    }

    // ---------- customer tracking (public by unguessable link) ----------
    // Document id = a 256-bit random token. It holds only: request code, status, times.
    // No name, phone, addresses, accessibility details or admin history.
    match /tracking/{token} {
      // Anyone holding the exact link may read it until it expires. No listing, so
      // tokens can't be discovered; the short request code grants nothing.
      allow get: if request.time < resource.data.expiresAt;
      allow list, delete: if false;

      allow create: if token.matches('^[A-Za-z0-9_-]{43}$')
        && request.resource.data.keys().hasOnly(['v', 'rid', 'code', 'status', 'createdAt', 'updatedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['v', 'rid', 'code', 'status', 'createdAt', 'updatedAt', 'expiresAt'])
        && request.resource.data.v == 1
        // same status as the request it belongs to; anything but "new" only by an admin
        && request.resource.data.status == getAfter(/databases/$(database)/documents/requests/$(request.resource.data.rid)).data.status
        && (request.resource.data.status == 'new' || isAdmin())
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(1, 'd')
        && request.resource.data.expiresAt < request.time + duration.value(121, 'd')
        && request.resource.data.rid is string
        // only together with a brand-new request that points back to this token
        && !exists(/databases/$(database)/documents/requests/$(request.resource.data.rid))
        && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.rid)).data.trackToken == token
        && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.rid)).data.code == request.resource.data.code;

      // Only an admin, only status + time, and only in step with the request itself.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'in_progress', 'confirmed', 'cancelled', 'completed']
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/requests/$(resource.data.rid)).data.status == request.resource.data.status;
    }

    function validHistoryEntry(h, status) {
      return h is map && h.keys().hasOnly(['status', 'at', 'by']) && h.keys().hasAll(['status', 'at', 'by'])
        && h.status == status
        && h.by == request.auth.token.email
        && h.at is timestamp
        && h.at > request.time - duration.value(10, 'm')
        && h.at < request.time + duration.value(10, 'm');
    }

    // ---------- daily counters (flood control) ----------
    // Each new request increments both counters by exactly 1. Nobody can read them.
    match /dailyCount/{day} {
      allow read, delete: if false;
      allow create, update: if day == todayKey()
        && counterOk(request.resource.data, resource == null ? 0 : resource.data.n, siteDailyCap());
    }

    match /phoneDaily/{key} {
      allow read, delete: if false;
      allow create, update: if counterOk(request.resource.data, resource == null ? 0 : resource.data.n, phoneDailyCap())
        && key == todayKey() + '_' + getAfter(/databases/$(database)/documents/requests/$(request.resource.data.lastId)).data.phoneKey;
    }

    // n goes up by one, stays under the cap, and points at a brand-new request
    // written in the same batch.
    function counterOk(d, prev, cap) {
      return d.keys().hasOnly(['n', 'lastId']) && d.keys().hasAll(['n', 'lastId'])
        && d.n is int && d.n == prev + 1 && d.n <= cap
        && d.lastId is string
        && existsAfter(/databases/$(database)/documents/requests/$(d.lastId))
        && !exists(/databases/$(database)/documents/requests/$(d.lastId));
    }

    // ---------- notification markers ----------
    // Written only by the server (Admin SDK, which bypasses these rules) to send at most
    // one "new request" message per request. No browser may read or write them.
    match /notifications/{id} {
      allow read, write: if false;
    }

    // ---------- admin allowlist ----------
    // Documents here are created by hand in the Firebase console (document id = the
    // admin's Auth UID). No client can write them.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
